# Alternate Mining Drones - every setting, with its default.
#
# Precedence: real environment variable > config/alternateMiningDrones.json
#             > this file > built-in default.
#
# Nothing has to be set: the shipped defaults auto-mine with the drone
# control range of whatever ship launched the drones.
#
# Per-character choices are NOT here. They live in
# config/alternateMiningDrones.players.json and are written by /atm (or the
# plain-chat !atm trigger) as each player changes something.

# 1 = automatic mining on, 0 = mining drones stay manual (vanilla).
EVEJS_ALT_MINING_DRONES=1

# ---------------------------------------------------------------------------
# Targeting
# ---------------------------------------------------------------------------
# spread  one rock per idle drone; the closest rock still collects the rest
#         once every other rock in range has a drone on it.
# focus   every idle drone on the closest rock that can be mined.
EVEJS_ALT_MINING_DRONES_TARGET_MODE=spread

# Distance in meters added to a rock's distance for every drone already sent
# to it, which is what keeps spread mode from stacking on one rock. Set it to
# 0 to make spread behave like focus.
EVEJS_ALT_MINING_DRONES_CLAIM_PENALTY_METERS=15000

# ---------------------------------------------------------------------------
# What to mine
# ---------------------------------------------------------------------------
# Players build their own queue with /atm filter add veldspar, kernite, 16268 -
# the order typed is the order mined, and an entry is a rock name or a type ID.
# A word that stands for a whole kind is passed over with a warning: /atm filter
# clear ice is what empties the ice list, and /atm filter move reorders with the
# numbers a reply prints. Names are separated by commas, so a name that holds a
# space stays one name (gneiss, dark ochre); a line typed without commas is read
# at the spaces, with any run of words that names a rock joined back up first.
# The accepted spellings are /atm, /altmining, !atm and !altmining; the queue is
# stored per character in the players file. The keys below are the server-side
# defaults of that feature.
#
# How many rocks one scan may look at while a filter is set. A filter has to see
# past the rocks a player does not want, so the window is wider than
# MAX_CANDIDATES while one is active.
EVEJS_ALT_MINING_DRONES_FILTER_SCAN_LIMIT=512

# What happens when a filter matches nothing in range:
#   any    mine the closest rock anyway (default; drones never sit idle)
#   idle   leave those drones parked until something they asked for turns up
EVEJS_ALT_MINING_DRONES_FILTER_FALLBACK=any

# Mine the richest grade of a rock in range before the plainer ones. The game
# spawns the same ore at several grades and the type name says which it is
# (Veldspar II-Grade, Blue Ice IV-Grade), so this prefers the best grade of a
# family and works down. false (default) counts every grade the same. A player
# turns it on for themselves with /atm filter grade on.
EVEJS_ALT_MINING_DRONES_FILTER_GRADE=false

# Apply a queue change to the drones that are already mining: they are
# re-targeted once on the next scan, a second later, instead of finishing the
# rock the queue no longer wants. false keeps the older way.
EVEJS_ALT_MINING_DRONES_RETARGET_ON_FILTER_CHANGE=true

# ---------------------------------------------------------------------------
# Drone control range
# ---------------------------------------------------------------------------
# ship  (default) track the ship: 20 km base, +5 km per Drone Avionics level,
#       +3 km per Advanced Drone Avionics level, +20 km per fitted Drone Link
#       Augmentor, plus any implant or booster bonus. A Rorqual at all-V with
#       three augmentors and a Halcyon Y-5 resolves to 140 km - exactly what
#       the client shows.
# fixed use EVEJS_ALT_MINING_DRONES_RANGE_METERS for everyone.
#
# Leave RANGE_MODE unset to pick automatically: naming RANGE_METERS alone
# selects fixed mode, leaving it empty selects ship mode.
# EVEJS_ALT_MINING_DRONES_RANGE_MODE=ship
# EVEJS_ALT_MINING_DRONES_RANGE_METERS=120000

# Clamp applied to whichever of the two modes is active, in meters.
EVEJS_ALT_MINING_DRONES_RANGE_MIN_METERS=1000
EVEJS_ALT_MINING_DRONES_RANGE_MAX_METERS=1000000

# Only read when the droneControlDistance attribute cannot be resolved from
# static data. The SDE carries 20000.
EVEJS_ALT_MINING_DRONES_BASE_RANGE_METERS=20000

# ---------------------------------------------------------------------------
# When the drones come home
# ---------------------------------------------------------------------------
# The hull decides, not the player. The server delivers into the first bay that has any room at
# all - the specialized ore/ice/gas bay when the hull has one, then the general mining hold, then
# the ordinary cargo hold - and it abandons a cycle that cannot fit one whole unit instead of
# moving on to the next bay. A hull with a mining bay of its own therefore never sees ore land in
# its cargo hold, so the squadron always comes home on the mining bay. Only a hull with no mining
# bay at all is judged on its cargo hold. Bays that cannot hold ore in the first place - fuel, ship
# maintenance, fleet hangar - are never consulted.
# The removed EVEJS_ALT_MINING_DRONES_HOLD_STOP_MODE knob (and the holdStopMode JSON key) is now
# ignored: "all" could never do anything the server actually honours.

# Recall as soon as the bay the server delivers into has less than this many
# cubic metres free. This is what stops the endless idle/mining flapping a
# nearly-full bay causes on its own, and it also covers compressed ore whose
# units are a fraction of a cubic metre. 0 disables the margin and leaves only
# the server's "one whole unit must fit" rule.
EVEJS_ALT_MINING_DRONES_MIN_HOLD_FREE_VOLUME_M3=2

# 1 = recall the ship's mining drones when the bays the player asked us to
#     watch can no longer accept one more unit. 0 = never recall for space,
#     and let the drones sit idle once a bay is full.
EVEJS_ALT_MINING_DRONES_RECALL_ON_FULL_HOLD=1

# ---------------------------------------------------------------------------
# Under attack
# ---------------------------------------------------------------------------
# 1 = recall them when one of them takes damage. Drones are cheap; a hostile
#     in the belt is not.
EVEJS_ALT_MINING_DRONES_RECALL_ON_DAMAGE=1

# Extra fraction of a drone's total HP it must lose in one scan before the
# recall triggers, 0..1. 0 recalls on any damage at all.
EVEJS_ALT_MINING_DRONES_DAMAGE_THRESHOLD=0

# ---------------------------------------------------------------------------
# Manual orders
# ---------------------------------------------------------------------------
# What happens after a player gives one of their mining drones an order by
# hand (F1/F2 attack, mine, return to bay, abandon...):
# hold   (default) that drone is left completely alone until it is scooped
#        back into the bay and launched again. The rest of the squadron keeps
#        working.
# recall only a manual recall (return home / return to bay / abandon) is
#        treated as a takeover; an incidental order is not.
# off    the mod keeps automating the drone as soon as it goes idle again.
EVEJS_ALT_MINING_DRONES_PLAYER_CONTROL_POLICY=hold

# ---------------------------------------------------------------------------
# Players
# ---------------------------------------------------------------------------
# 1 = players may use /atm on|off, /atm spread|focus, /atm range,
#     /atm threshold, /atm control, /atm resume and /atm reset for their own
#     character, and build their own mining queue with
#     /atm filter add|move|del.
#     0 removes per-character control for everyone and leaves only the server
#     defaults above.
EVEJS_ALT_MINING_DRONES_ALLOW_PLAYER_TOGGLE=1

# 1 = players may use /atm copy <name|id> to take another character's whole
#     setup (mode, threshold, takeover rule, range and queue) onto their own.
#     Part of a name is enough, so no numeric ID is needed, and /atm copy list on its
#     own shows who is stored here. The settings live in the players file that
#     every entry sits in, so nothing private is involved, and a source with
#     nothing saved is refused, so a mistyped name cannot wipe a setup.
#     0 removes the command.
EVEJS_ALT_MINING_DRONES_ALLOW_PLAYER_COPY=1

# 1 = the plain-chat trigger works: typing "!atm focus" into ordinary
#     chat does the same as "/atm focus". This is the only channel a
#     character without staff rights can use, because the client refuses to
#     send slash commands for them. The line is consumed and never broadcast
#     to the channel. 0 removes the trigger.
EVEJS_ALT_MINING_DRONES_CHAT_TRIGGER=1

# Per-character starting state. 0 lets each player opt in with
# /atm on; anyone who never types it is left alone.
EVEJS_ALT_MINING_DRONES_ENABLED_BY_DEFAULT=1

# ---------------------------------------------------------------------------
# Client state handshake
# ---------------------------------------------------------------------------
# How long after a drone appears before the first rock is named, in
# milliseconds. The client learns about a freshly launched drone from a
# delayed batch, so an order that arrives first is overwritten by the
# pre-order snapshot and the drone window shows "idle" while the drone flies.
EVEJS_ALT_MINING_DRONES_POST_LAUNCH_DELAY_MS=2000

# After an order, re-send the drone's own state at these offsets (milliseconds,
# comma separated) until the server reports it mining. This is what makes the
# drone window show "approaching" and puts the drone icon under a locked
# asteroid: the server only notifies on change, and mining the same rock for a
# minute is not a change.
EVEJS_ALT_MINING_DRONES_STATE_REFRESH_MS=0,1000,2500,5000

# While a drone is mining, re-send its state this often (milliseconds), so a
# client that missed a notification recovers on its own. 0 disables it.
EVEJS_ALT_MINING_DRONES_STATE_KEEP_ALIVE_MS=5000

# Safety net: a drone re-tasked this many times inside a 15 s window without
# the bay gaining anything is parked instead of being thrown at the same rock
# forever. 0 disables the guard.
EVEJS_ALT_MINING_DRONES_MAX_STALLED_REASSIGNMENTS=4

# ---------------------------------------------------------------------------
# Rocks that appear after the scene was first mined
# ---------------------------------------------------------------------------
# 1 = rebuild a system's mining cache when it predates a mineable rock that is
#     now present. The server builds that cache once per scene, so a moon-ore
#     chunk that spawns into a system somebody is already mining is invisible to
#     every mining path - including a manual laser - until the cache is dropped
#     again. The rebuild is triggered by the arrival of a rock the cache does not
#     know about, never by a timer, so it cannot loop.
EVEJS_ALT_MINING_DRONES_REFRESH_STALE_SCENE_CACHE=1

# ---------------------------------------------------------------------------
# Cost control
# ---------------------------------------------------------------------------
# How often a scene is scanned for idle mining drones, in milliseconds.
# 500 = twice a second. Higher is cheaper and slower to react.
EVEJS_ALT_MINING_DRONES_SCAN_INTERVAL_MS=500

# Rocks considered per ship per scan, closest first.
EVEJS_ALT_MINING_DRONES_MAX_CANDIDATES=48

# Where the per-character file lives. Empty = config/alternateMiningDrones.players.json,
# relative to the EveJS root. An absolute path is used as written.
EVEJS_ALT_MINING_DRONES_PLAYERS_FILE=

# Log every assignment, recall and parked drone. Noisy; for debugging only.
EVEJS_ALT_MINING_DRONES_VERBOSE=0